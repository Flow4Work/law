# Server-only JSON array of cloud connections, stored as a Secret on Vercel.
# Fields: id, name, provider, model, baseUrl, key; optional: effort, isDefault.
# Never use a NEXT_PUBLIC_ prefix for this value or commit a populated file.
LEGAL_MODEL_CONNECTIONS=
# Encrypts visitors' private API connections in HttpOnly browser cookies.
# Set a random value of at least 32 characters as a Vercel Secret.
LEGAL_CONNECTION_SECRET=
# B.AI lists permitted text models automatically when BAI_MODEL is empty.
# The existing Vercel variable name b_ai is also supported.
BAI_API_KEY=
BAI_MODEL=
BAI_BASE_URL=https://api.b.ai/v1
# Alternatively configure one of the supported providers directly.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# The officially documented public 'test' OC can be used for development only.
# Production requires your own law.go.kr-issued OC value.
LAW_API_OC=
LEGAL_MODEL_WORKSPACE=
